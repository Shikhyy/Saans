{
  "name": "saans",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SAANS — a breath budget for your household. Live air-quality data turned into a day you can actually change.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@hono/node-server": "^1.14.0",
    "gsap": "^3.12.7",
    "hono": "^4.7.0",
    "lenis": "^1.3.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter-tight": "^5.1.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "@fontsource/mukta": "^5.1.0",
    "@fontsource/tiro-devanagari-hindi": "^5.1.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "axe-core": "^4.10.2",
    "eslint": "^9.19.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
