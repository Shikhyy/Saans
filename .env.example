# Optional. Without a key SAANS runs on its deterministic planning engine,
# which produces the same structured plan with zero network calls.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=8787
# Comma separated origins allowed to call the API (defaults to same-origin only)
ALLOWED_ORIGINS=
